# Copy to .env and edit. Every value here is also a CLI flag on the benchmark.

# --- Scenario -------------------------------------------------------------
BV_SCENARIO=loan              # loan | booking

# --- VAD / turn taking ----------------------------------------------------
# The single largest lever on TTFA. Both are silence the caller sits through
# before any model runs. Lower = snappier, but cuts off callers who pause
# mid-sentence, which Bangla speakers do between clauses.
BV_VAD_STOP_SECS=0.5
BV_VAD_TURN_STOP_TIMEOUT=0.4
BV_VAD_START_SECS=0.2
BV_VAD_CONFIDENCE=0.7

# --- STT ------------------------------------------------------------------
# Any faster-whisper size or a HF repo id (e.g. a Bangla fine-tune).
BV_STT_MODEL=large-v3
BV_STT_LANGUAGE=bn
BV_STT_BEAM_SIZE=1
# BV_STT_DEVICE=cuda
# BV_STT_COMPUTE_TYPE=float16

# --- LLM (any OpenAI-compatible endpoint) ---------------------------------
BV_LLM_BASE_URL=http://localhost:11434/v1
BV_LLM_API_KEY=ollama
BV_LLM_MODEL=qwen3.8:latest
BV_LLM_MAX_TOKENS=160
BV_LLM_TEMPERATURE=0.3
# Reasoning tokens are silence on a phone call. Leave on.
BV_LLM_DISABLE_THINKING=true

# --- TTS ------------------------------------------------------------------
BV_TTS_MODEL=facebook/mms-tts-ben
BV_TTS_MAX_CHARS=160

# --- Audio / server -------------------------------------------------------
BV_AUDIO_IN_RATE=16000
BV_AUDIO_OUT_RATE=16000
BV_HOST=0.0.0.0
BV_PORT=8765

# --- Profiling ------------------------------------------------------------
BV_PROFILE=true
BV_PROFILE_JSONL=runs/turns.jsonl
BV_PROFILE_LIVE=true

# --- STT robustness -------------------------------------------------------
# Whisper's failure mode on hard Bangla is a repetition loop: 15s to decode
# 2s of audio, emitting the same phrase over and over. These bound it.
BV_STT_REPETITION_PENALTY=1.15
BV_STT_MAX_TOKENS_PER_SEC=45
BV_STT_MIN_DECODE_TOKENS=96
